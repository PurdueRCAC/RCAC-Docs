{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "myquota": "allow",
      "slist": "allow",
      "sfeatures": "allow",
      "module list": "allow",
      "module avail *": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  },
  "mcp": {
    "rcac-docs": {
      "type": "remote",
      "url": "https://docs.rcac.purdue.edu/mcp",
      "enabled": true
    }
  }
}
